# Exemplo das variáveis do projeto — SEM valores. Os valores de verdade
# moram só na Vercel (Settings → Environment Variables), marcados como
# "Sensitive". Nunca crie um .env com valores no repositório: o .gitignore
# bloqueia, mas o certo é nem existir.

# PostHog (análise). Públicas por natureza: só enviam eventos, não leem dados.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# B4TIDA — biblioteca de criações (só no servidor, app/api/batida)
# token do Vercel Blob: restrito a UM armazenamento. Só produção, Sensitive.
BLOB_READ_WRITE_TOKEN=
# senha da curadoria (lista completa e destaques). Aleatória, 32+ caracteres.
BATIDA_ADMIN_KEY=
