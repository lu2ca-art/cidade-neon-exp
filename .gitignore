# v0 runtime files (should only exist in preview, not in git)
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts

# Common ignores
node_modules/
.next/
.env*.local
.DS_Store
tsconfig.tsbuildinfo

# Package manager consistency — bun é o padrão do projeto
pnpm-lock.yaml
package-lock.json
yarn.lock

# Bibliotecas grandes de assets brutos ficam fora do git
# (a biblioteca completa vive em ~/obras_dominio_publico/)
public/obras/

# Cenas e referências brutas do Blender (binário, sem histórico útil em git).
# Fonte de verdade fica local em blender/cenas/ — só os .glb exportados e
# curados em blender/exports/ (ou já promovidos pra public/models/) vão pro git.
blender/cenas/
blender/refs/


# Salas com assets curados que devem ser commitados:
# (não adicionar novas linhas de ignore que apaguem estas)
!public/galeria/**
!public/museu/**
!public/loja-discos/**
!public/radio-222/**

# Documentos e briefings efêmeros na raiz do repo
VISION.md
STATE_AUDIT_REPORT.md
