# v0 runtime files (should only exist in preview, not in git)
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts

# Common ignores
node_modules/
.next/
.env*.local
.DS_Store
.vercel
tsconfig.tsbuildinfo

# Package manager consistency — bun é o padrão do projeto
pnpm-lock.yaml
package-lock.json
yarn.lock

# Bibliotecas grandes de assets brutos ficam fora do git
# (a biblioteca completa vive em ~/obras_dominio_publico/)
public/obras/

# Assets de áudio brutos NÃO commitar; áudios CURADOS por sala SIM.
# Pra evitar acidentes, ignora a raiz + libera explicitamente as salas ativas.
/*.mp3
/*.wav
/*.flac
/*.ogg

# Salas com assets curados que devem ser commitados:
# (não adicionar novas linhas de ignore que apaguem estas)
!public/galeria/**
!public/museu/**
!public/loja-discos/**
!public/radio-222/**

# Documentos e briefings efêmeros na raiz do repo
VISION.md
CLAUDE.md
STATE_AUDIT_REPORT.md
